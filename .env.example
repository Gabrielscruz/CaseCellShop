PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=casecellshop
DB_PASSWORD=casecellshop_pwd
DB_NAME=casecellshop_db
DATABASE_URL=postgresql://casecellshop:casecellshop_pwd@postgres:5432/casecellshop_db?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=casecellshop
RABBITMQ_PASSWORD=casecellshop_pwd
RABBITMQ_URL=amqp://casecellshop:casecellshop_pwd@rabbitmq:5672

# Queue Settings
ORDERS_QUEUE_NAME=orders.process
ORDERS_DLQ_NAME=orders.dlq

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
